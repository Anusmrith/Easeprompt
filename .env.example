# Easeprompt Environment Configuration
# If no API key is provided, Easeprompt uses its built-in Expert Heuristic & Semantic Meta-Prompt Engine!

# Default Provider: "builtin" (no key needed), "gemini", "openai", "groq", or "ollama"
DEFAULT_PROVIDER=builtin

# Optional: Google Gemini API Key
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Optional: Groq API Key
GROQ_API_KEY=

# Optional: Ollama Base URL (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Server Settings
HOST=127.0.0.1
PORT=8000
